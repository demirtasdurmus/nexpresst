{
  "name": "nexpresst",
  "version": "1.6.0-rc.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demirtasdurmus/nexpresst.git"
  },
  "bugs": {
    "url": "https://github.com/demirtasdurmus/nexpresst/issues"
  },
  "homepage": "https://github.com/demirtasdurmus/nexpresst#readme",
  "keywords": [
    "next.js",
    "express",
    "serverless",
    "api",
    "typescript"
  ],
  "author": "Durmus Demirtas",
  "license": "MIT",
  "description": "Write express-like APIs with Next.js serverless functions",
  "scripts": {
    "build": "tsc --pretty -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev:tsc": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
    "dev:node": "node --watch dist/index.js",
    "dev": "npm run dev:tsc & npm run dev:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "commit": "commit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@commitlint/prompt-cli": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "tsc-files": "^1.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "next": "^15.5.8"
  }
}
